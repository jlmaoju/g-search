# ============================================================
# G-Search runtime config
# ============================================================
#
# The key goes here. Leave it blank if you only want degraded keyword search.
# Full semantic search requires your own Zhipu / BigModel API key.
#
# >>> PASTE YOUR KEY AFTER THE EQUAL SIGN <<<
ZHIPU_API_KEY=

# Qdrant settings used by launchers/start_gsearch.ps1.
# If you use the provided data package, keep these defaults.
GCORES_QDRANT_URL=http://127.0.0.1:6336
GCORES_QDRANT_API_KEY=
GCORES_QDRANT_COLLECTION=gcores_memory_release_v3

# Optional: used only by the packaged local Viewer flow.
GSEARCH_VIEWER_FALLBACK_API_KEY=

# Optional: only needed if you run Volcengine transcription jobs yourself.
VOLCENGINE_APP_ID=
VOLCENGINE_ACCESS_KEY=
